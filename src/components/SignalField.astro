---
// Ambient backdrop: a sparse star field with a faint scan line sweeping across,
// like a radio telescope's receiver. Static when motion is reduced.
---
<canvas id="signal-field" aria-hidden="true"></canvas>

<style>
  #signal-field {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('signal-field') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Star = { x: number; y: number; r: number; phase: number };
  let stars: Star[] = [];
  let w = 0;
  let h = 0;

  function resize() {
    const dpr = Math.min(devicePixelRatio || 1, 2);
    w = innerWidth;
    h = innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const count = Math.round((w * h) / 9000);
    stars = Array.from({ length: count }, () => ({
      x: Math.random() * w,
      y: Math.random() * h,
      r: Math.random() * 1.1 + 0.2,
      phase: Math.random() * Math.PI * 2,
    }));
  }

  function draw(t: number) {
    ctx.clearRect(0, 0, w, h);
    for (const s of stars) {
      const a = still ? 0.5 : 0.35 + 0.3 * Math.sin(t / 1400 + s.phase);
      ctx.fillStyle = `rgba(200, 230, 255, ${a})`;
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
      ctx.fill();
    }
    if (!still) {
      const y = ((t / 40) % (h + 200)) - 100;
      const g = ctx.createLinearGradient(0, y - 80, 0, y + 2);
      g.addColorStop(0, 'rgba(143, 211, 255, 0)');
      g.addColorStop(1, 'rgba(143, 211, 255, 0.05)');
      ctx.fillStyle = g;
      ctx.fillRect(0, y - 80, w, 82);
      requestAnimationFrame(draw);
    }
  }

  resize();
  addEventListener('resize', () => {
    resize();
    if (still) draw(0);
  });
  requestAnimationFrame(draw);
</script>
