---
// The garden layer: one fixed canvas behind the page where the bonsai lives.
// Sections marked data-scene tell it where to stand. Decoration only: all text stays in the HTML.
---
<div class="garden" id="garden" aria-hidden="true">
  <canvas id="garden-gl"></canvas>
  <!-- Shown instead of the canvas when WebGL is unavailable. -->
  <svg class="still" viewBox="0 0 200 200">
    <ellipse cx="100" cy="182" rx="70" ry="6" fill="#000" opacity=".35" />
    <path d="M44 150h112l-8 30H52z" fill="#c98b6b" />
    <path d="M40 146h120v6H40z" fill="#b57a5c" />
    <path d="M98 148c2-16-8-26 2-40s-6-22 4-38" stroke="#6e5443" stroke-width="7" fill="none" stroke-linecap="round" />
    <path d="M100 110c-14-4-26-2-40 4M104 84c14-6 26-4 38 2" stroke="#6e5443" stroke-width="4" fill="none" stroke-linecap="round" />
    <g fill="#7f9a63">
      <ellipse cx="56" cy="110" rx="24" ry="11" />
      <ellipse cx="146" cy="84" rx="26" ry="11" />
      <ellipse cx="104" cy="62" rx="30" ry="14" />
    </g>
    <g fill="#a9c28c">
      <ellipse cx="62" cy="106" rx="14" ry="6" />
      <ellipse cx="150" cy="80" rx="15" ry="6" />
      <ellipse cx="110" cy="56" rx="18" ry="7" />
    </g>
  </svg>
</div>

<style>
  .garden { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  #garden-gl { display: block; width: 100%; height: 100%; opacity: 0; }
  .still { display: none; position: absolute; width: min(38vw, 420px); right: 8vw; top: 50%; transform: translateY(-50%); }
  .garden.no-gl #garden-gl { display: none; }
  .garden.no-gl .still { display: block; }
  :global(html.garden-hover), :global(html.garden-hover body) { cursor: grab; }
  :global(html.garden-drag), :global(html.garden-drag *) { cursor: grabbing !important; user-select: none; }
  @media (max-width: 760px) {
    .still { width: 58vw; right: 21vw; top: 88px; transform: none; }
    .garden.no-gl.away .still { opacity: 0.12; }
  }
</style>

<script>
  import { revealAfter } from '../scripts/motion';

  const root = document.getElementById('garden')!;
  const canvas = document.getElementById('garden-gl') as HTMLCanvasElement;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // Keep in sync with SCENES in garden.js (not imported, so the engine stays lazy-loaded).
  const SCENES = ['hero', 'experience', 'projects', 'ai', 'contact'];
  const sections = SCENES.map((s) => document.querySelector<HTMLElement>(`[data-scene="${s}"]`)).filter(Boolean) as HTMLElement[];

  // Which scene holds the middle of the screen, how far through it we are,
  // and how close the next one is (so the tree starts moving before the section changes).
  type View = { scene: number; p: number; blend: number };
  const read = (): View => {
    const mid = innerHeight * 0.5, lead = innerHeight * 0.4;
    const tops = sections.map((s) => s.getBoundingClientRect().top);
    let i = 0;
    tops.forEach((t, k) => { if (t <= mid) i = k; });
    const end = i + 1 < tops.length ? tops[i + 1] : sections[i].getBoundingClientRect().bottom;
    const p = Math.min(1, Math.max(0, (mid - tops[i]) / Math.max(1, end - tops[i])));
    const blend = i + 1 < tops.length ? Math.min(1, Math.max(0, (mid + lead - tops[i + 1]) / lead)) : 0;
    return { scene: SCENES.indexOf(sections[i].dataset.scene!), p, blend };
  };

  let garden: { setView(s: number, p: number, b: number): void; resize(): void; burst(n?: number): void; lightStone(i: number): void; start(): void; draw(): void } | null = null;
  const onScroll = () => {
    const v = read();
    root.classList.toggle('away', v.scene > 0 && v.scene < 4);
    garden?.setView(v.scene, v.p, v.blend);
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // The page asks for a leaf fall (email copied) or a lit stone (a principle in focus).
  document.addEventListener('garden:burst', () => garden?.burst());
  document.addEventListener('garden:stone', (e) => garden?.lightStone((e as CustomEvent<number>).detail));

  const hasWebGL = (() => {
    try { return !!document.createElement('canvas').getContext('webgl2'); } catch { return false; }
  })();

  // Load Three.js after first paint, so the words are readable immediately.
  async function boot() {
    if (!hasWebGL) { root.classList.add('no-gl'); document.documentElement.classList.add('no-gl'); return; }
    const [THREE, { createGarden }] = await Promise.all([import('../scripts/three-lite'), import('../scripts/garden.js')]);
    garden = createGarden({ THREE, canvas, reducedMotion });
    onScroll();
    addEventListener('resize', () => garden!.resize());
    if (reducedMotion) garden.draw();
    else garden.start();
  }
  revealAfter(boot);
</script>
