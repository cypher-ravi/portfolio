---
// Layout for pages beyond the home page (the research index and each write-up):
// the same header mark, a short nav back into the site, and the footer.
import Base from './Base.astro';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  current?: 'research';
}
const { title, description, current } = Astro.props;
const home = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={title} description={description}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="bar" id="bar">
    <div class="wrap bar-inner">
      <a class="mark" href={`${home}/`}>{profile.name}<span>.</span></a>
      <nav aria-label="Site">
        <a href={`${home}/#projects`}>Projects</a>
        <a href={`${home}/research/`} aria-current={current === 'research' ? 'page' : undefined}>Research</a>
        <a href={`${home}/#contact`}>Contact</a>
        <a class="nav-cta" href={profile.links.resume}>Resume</a>
      </nav>
    </div>
  </header>

  <main id="main" class="wrap page">
    <slot />
  </main>

  <footer class="wrap foot">
    <span class="label">Built by {profile.name} · 2020 to now</span>
    <a href={`${home}/`}>Back to the portfolio</a>
  </footer>
</Base>

<style>
  .skip {
    position: absolute; left: 12px; top: -60px; z-index: 10;
    background: var(--text); color: var(--bg); padding: 10px 14px; border-radius: 6px; font-weight: 600;
  }
  .skip:focus { top: 12px; }
  .bar {
    position: sticky; top: 0; z-index: 5; margin-inline: -20px; padding-inline: 20px;
    border-bottom: 1px solid transparent;
    transition: background 0.5s var(--ease), border-color 0.5s var(--ease), backdrop-filter 0.5s var(--ease);
  }
  .bar:global(.scrolled) {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }
  .bar-inner { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 16px; }
  .mark { font: 700 1.3rem/1 var(--display); letter-spacing: -0.03em; color: var(--text); text-decoration: none; }
  .mark span { color: var(--accent); }
  nav { display: flex; align-items: center; gap: 26px; font: 450 0.9rem var(--sans); }
  nav a { color: var(--muted); text-decoration: none; transition: color 0.3s var(--ease); }
  nav a:hover, nav a[aria-current] { color: var(--text); }
  .nav-cta { padding: 8px 16px; border: 1px solid var(--line); border-radius: 999px; color: var(--text) !important; }
  .nav-cta:hover { border-color: var(--muted); }
  .page { padding-block: 90px 0; min-height: 70vh; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; padding-block: 36px 60px; border-top: 1px solid var(--line); margin-top: 140px; font-size: 0.9rem; }
  .foot a { color: var(--muted); text-decoration: none; }
  .foot a:hover { color: var(--text); }
  @media (max-width: 560px) {
    nav { gap: 14px; font-size: 0.85rem; }
    .nav-cta { padding: 6px 12px; }
    .page { padding-top: 56px; }
  }
</style>
