---
import Page from '../../layouts/Page.astro';
import { getCollection, render } from 'astro:content';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const entries = await getCollection('research');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const home = import.meta.env.BASE_URL.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
const stateLabel = { done: 'Done', now: 'In progress', next: 'Next' } as const;
---
<Page title={`${d.title} · Research · ${profile.name}`} description={d.summary} current="research">
  <a class="back label" href={`${home}/research/`}>← All research</a>

  <header class="head">
    <p class="label" data-reveal>{d.field} · <b>{d.status}</b> · updated {d.updated}</p>
    <h1 data-split>{d.title}</h1>
    <p class="lede" data-reveal>{d.summary}</p>
    {d.links.length > 0 && (
      <div class="ctas" data-reveal>
        {d.links.map((l, i) => <a class={i === 0 ? 'btn primary' : 'btn'} href={l.href}>{l.label}</a>)}
      </div>
    )}
  </header>

  <div class="layout">
    <aside class="side" data-reveal>
      <div class="q">
        <p class="label">Research question</p>
        <p>{d.question}</p>
      </div>
      {d.phases.length > 0 && (
        <div>
          <p class="label">Progress</p>
          <ol class="phases">
            {d.phases.map((p, k) => (
              <li class={p.state}>
                <span class="label">{pad(k + 1)} · {stateLabel[p.state]}</span>
                <span>{p.title}</span>
              </li>
            ))}
          </ol>
        </div>
      )}
      {d.stack.length > 0 && (
        <div>
          <p class="label">Stack</p>
          <ul class="tags">{d.stack.map((s) => <li>{s}</li>)}</ul>
        </div>
      )}
    </aside>

    <article class="prose" data-reveal>
      <Content />
    </article>
  </div>
</Page>

<style>
  .back { display: inline-block; margin-bottom: 36px; text-decoration: none; }
  .back:hover { color: var(--text); }
  .head { display: grid; gap: 20px; margin-bottom: 72px; }
  h1 { font-size: clamp(2.6rem, 6.5vw, 5rem); }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 58ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }

  .layout { display: grid; grid-template-columns: 300px 1fr; gap: 64px; align-items: start; }
  .side { position: sticky; top: 96px; display: grid; gap: 32px; }
  .head .label { line-height: 1.8; }
  .side .label { margin-bottom: 12px; }
  .q p:last-child { font-size: 1.02rem; line-height: 1.55; }
  .phases { list-style: none; margin: 0; padding: 0 0 0 22px; display: grid; gap: 16px; position: relative; }
  .phases::before { content: ''; position: absolute; left: 3px; top: 6px; bottom: 6px; width: 1px; background: var(--line); }
  .phases li { position: relative; display: grid; gap: 4px; font-size: 0.95rem; }
  .phases li .label { margin: 0; }
  .phases li::before {
    content: ''; position: absolute; left: -22px; top: 4px; width: 7px; height: 7px; border-radius: 50%;
    border: 1px solid var(--muted); background: var(--bg);
  }
  .phases li.done::before { background: color-mix(in srgb, var(--accent) 55%, var(--bg)); border-color: transparent; }
  .phases li.now::before { background: var(--accent); border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent); }
  .phases li.now .label { color: var(--accent); }
  .phases li.next { color: var(--muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .tags li { font: 450 0.76rem/1 var(--sans); padding: 7px 11px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }

  /* The Markdown write-up */
  .prose { max-width: 68ch; display: grid; gap: 18px; font-size: 1.05rem; line-height: 1.7; }
  .prose :global(h2) { font-size: clamp(1.5rem, 2.6vw, 1.9rem); letter-spacing: -0.025em; margin-top: 30px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: 1.15rem; margin-top: 12px; }
  .prose :global(p), .prose :global(li) { color: color-mix(in srgb, var(--text) 82%, var(--muted)); max-width: none; }
  .prose :global(strong) { color: var(--text); }
  .prose :global(ul), .prose :global(ol) { margin: 0; padding-left: 1.2em; display: grid; gap: 8px; }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(code) { font: 0.9em var(--mono); padding: 2px 6px; border-radius: 6px; background: var(--surface); border: 1px solid var(--line); }
  .prose :global(a) { color: var(--accent); }
  .prose :global(em) { color: var(--text); }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: 48px; }
    .side { position: static; }
  }
</style>
