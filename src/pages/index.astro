---
import Base from '../layouts/Base.astro';
import Mission from '../components/Mission.astro';
import { profile, glance, projects, principles } from '../data/profile';
import { legs } from '../data/mission';
import { roadmaps } from '../data/roadmaps';

const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
  title={`${profile.name} · ${profile.role}`}
  description={`${profile.name}, ${profile.role}. ${profile.headline.join(' ')}`}
>
  <Mission />
  <a class="skip" href="#main">Skip to content</a>

  <header class="bar" id="bar">
    <div class="wrap bar-inner">
      <a class="mark" href="#top">{profile.name}<span>.</span></a>
      <nav aria-label="Sections">
        <a href="#experience" data-nav class="opt">Experience</a>
        <a href="#projects" data-nav>Projects</a>
        <a href="#ai" data-nav class="opt">AI</a>
        <a href="#learning" data-nav class="opt">Learning</a>
        <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/research/`}>Research</a>
        <a href="#contact" data-nav>Contact</a>
        <a class="nav-cta" href={profile.links.resume}>Resume</a>
      </nav>
    </div>
  </header>

  <main id="main">
    <section class="hero wrap" id="top" data-scene="hero">
      <div class="hero-copy">
        <p class="label" data-reveal>{profile.name} · {profile.role} · India</p>
        <h1 data-split>{profile.headline[0]} <em>{profile.headline[1]}</em></h1>
        <p class="lede" data-reveal>{profile.intro}</p>
        <div class="ctas" data-reveal>
          <a class="btn primary" href={profile.links.resume}>Resume</a>
          <a class="btn" href={`mailto:${profile.email}`}>Say hello</a>
        </div>
      </div>
      <p class="hint label" aria-hidden="true">Mission Ravi-1 · scroll to launch</p>
      <a class="scroll label" href="#glance" aria-label="Scroll to content"><i></i>Scroll</a>
    </section>

    <div class="wrap">
      <dl id="glance" class="glance" data-reveal>
        {glance.map((g) => (
          <div>
            <dt class="label">{g.label}</dt>
            <dd>{g.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <section id="experience" class="flight" aria-labelledby="flight-title">
      <header class="wrap head flight-head">
        <p class="label" data-reveal>Experience · 2020 to now</p>
        <h2 id="flight-title" data-split>Mission <em>Ravi-1</em></h2>
        <p class="lede" data-reveal>Every stage of my career did its job, then let go. What it gave me kept flying.</p>
      </header>
      <ol class="legs" data-mission-track>
        {legs.map((l, i) => (
          <li class="leg" id={`leg-${l.id}`}>
            <div class="wrap">
              <article class="leg-card">
                <p class="label"><b>{pad(i + 1)}</b> · {l.phase}</p>
                <h3>{l.title}</h3>
                {l.period && <p class="period">{l.period}</p>}
                <ul class="points">{l.points.map((x) => <li>{x}</li>)}</ul>
                {l.kept && (
                  <div class="kept">
                    <span class="label">Still on board</span>
                    <ul class="tags">{l.kept.map((k) => <li>{k}</li>)}</ul>
                  </div>
                )}
                {l.id === 'trajectory' && (
                  <div class="ctas">
                    <a class="btn primary" href="#contact">Start a conversation</a>
                    <a class="btn" href={profile.links.resume}>Resume</a>
                  </div>
                )}
              </article>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section id="projects" class="works" aria-labelledby="works-title" data-scene="projects">
      <div class="works-pin">
        <div class="wrap works-head">
          <header class="head">
            <p class="label" data-reveal>Projects</p>
            <h2 id="works-title" data-split>What I've <em>shipped</em>, and what's next</h2>
          </header>
          <p class="works-hint label" aria-hidden="true"><b id="works-count">01</b> / {pad(projects.length)} <span class="arrow">→</span></p>
        </div>
        <div class="cards-view" id="cards-view">
          <ul class="cards" id="cards">
            {projects.map((x, i) => (
              <li class={`card kind-${x.kind.toLowerCase()}`}>
                <div class="card-top">
                  <span class="label">{x.theme}</span>
                  <span class="label">{x.year}</span>
                </div>
                <h3>{x.name}</h3>
                <p>{x.tldr}</p>
                <div class="card-foot">
                  <span class="kind">{x.status ?? x.kind}</span>
                  {x.points.length > 0 && (
                    <button type="button" class="more" data-open={`p-${i}`} aria-haspopup="dialog">
                      Details <span aria-hidden="true">+</span>
                    </button>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {projects.map((x, i) => x.points.length > 0 && (
      <dialog class="detail" id={`p-${i}`} aria-labelledby={`p-${i}-t`}>
        <div class="detail-in">
          <div class="card-top">
            <span class="label">{x.theme} · {x.kind} · {x.year}</span>
            <form method="dialog"><button class="close" aria-label="Close">×</button></form>
          </div>
          <h3 id={`p-${i}-t`}>{x.name}</h3>
          <p class="tldr">{x.tldr}</p>
          <ul class="points">{x.points.map((p) => <li>{p}</li>)}</ul>
          <ul class="tags">{x.stack.map((s) => <li>{s}</li>)}</ul>
          {x.links && (
            <div class="detail-links">
              {x.links.map((l, j) => (
                <a class={j === 0 ? 'btn primary' : 'btn'} href={l.href} target="_blank" rel="noopener">{l.label}</a>
              ))}
            </div>
          )}
        </div>
      </dialog>
    ))}

    <div class="wrap">
      <section id="ai" class="block ai" data-scene="ai">
        <header class="head">
          <p class="label" data-reveal>How I use AI</p>
          <h2 data-split>Practical, <em>measured</em>, honest</h2>
        </header>
        <ol class="principles">
          {principles.map((p, i) => (
            <li data-reveal>
              <span class="label">{pad(i + 1)}</span>
              <p class="p-title">{p.title}</p>
              <p class="p-body">{p.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <section id="learning" class="block learning">
        <header class="head">
          <p class="label" data-reveal>Learning in public</p>
          <h2 data-split>Still <em>growing</em></h2>
          <p class="lede" data-reveal>Two roadmaps I'm working through now: what I'm learning, how, and where I am.</p>
        </header>
        <div class="tracks" role="tablist" aria-label="Roadmaps" data-reveal>
          {roadmaps.map((r, i) => (
            <button type="button" role="tab" id={`tab-${r.id}`} aria-controls={`road-${r.id}`} aria-selected={i === 0 ? 'true' : 'false'}>{r.name}</button>
          ))}
        </div>
        {roadmaps.map((r) => {
          const at = Math.max(0, r.stages.findIndex((s) => s.id === r.now));
          return (
            <div class="roadmap" id={`road-${r.id}`} role="tabpanel" aria-labelledby={`tab-${r.id}`}>
              <div class="road-head" data-reveal>
                <p class="road-name">{r.name}</p>
                <p class="road-why">{r.why}</p>
                <div class="meter" aria-label={`Stage ${at + 1} of ${r.stages.length}`}>
                  {r.stages.map((_, k) => <i class={k < at ? 'done' : k === at ? 'now' : ''} />)}
                </div>
                <p class="label">Stage {pad(at + 1)} of {pad(r.stages.length)} · updated {r.updated}</p>
              </div>
              <ol class="road">
                {r.stages.map((s, k) => {
                  const state = k < at ? 'done' : k === at ? 'now' : 'next';
                  return (
                    <li class={`stage ${state}`} data-reveal>
                      <p class="period">{pad(k + 1)} · {state === 'done' ? 'Done' : state === 'now' ? 'You are here' : 'Next'}</p>
                      <h3>{s.title}</h3>
                      {state === 'now' && <p class="now-note">{r.nowNote}</p>}
                      <ul class="tags">{s.learn.map((t) => <li>{t}</li>)}</ul>
                      <p class="how"><span class="label">How</span> {s.how}</p>
                    </li>
                  );
                })}
              </ol>
            </div>
          );
        })}
      </section>

      <section id="contact" class="block contact" data-scene="contact">
        <header class="head">
          <p class="label" data-reveal>Contact</p>
          <h2 data-split>Let's <em>talk.</em></h2>
        </header>
        <p class="lede" data-reveal>{profile.availability}. The fastest way to reach me is email. I reply within a day.</p>
        <div class="email-row" data-reveal>
          <span class="addr" id="email">{profile.email}</span>
          <button class="copy" type="button" id="copy-email" aria-live="polite">Copy</button>
        </div>
        <div class="ctas" data-reveal>
          <a class="btn primary" href={`mailto:${profile.email}`}>Send an email</a>
          <a class="btn" href={profile.links.linkedin}>LinkedIn</a>
          <a class="btn" href={profile.links.github}>GitHub</a>
          <a class="btn" href={profile.links.leetcode}>LeetCode</a>
        </div>
      </section>
    </div>
  </main>

  <footer class="wrap foot">
    <span class="label">Built by Ravi · 2020 to now</span>
    <a href="#top">Back to top ↑</a>
  </footer>
</Base>

<script>
  // Roadmaps: show one track at a time. Without JS both stay visible.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tracks [role="tab"]')];
  const pick = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
    }
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => pick(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const next = tabs[(i + d + tabs.length) % tabs.length];
      pick(next); next.focus();
    });
  });
  if (tabs[0]) pick(tabs[0]);

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const pad = (n: number) => String(n).padStart(2, '0');

  // Copy email: a short confirmation, or select the text as a fallback.
  const btn = document.getElementById('copy-email') as HTMLButtonElement;
  const email = document.getElementById('email')!;
  btn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(email.textContent ?? '');
      btn.textContent = 'Copied';
    } catch {
      const r = document.createRange();
      r.selectNodeContents(email);
      getSelection()?.removeAllRanges();
      getSelection()?.addRange(r);
      btn.textContent = 'Selected';
    }
    setTimeout(() => (btn.textContent = 'Copy'), 1800);
  });

  // Highlight the nav link for the section in view.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.hash.slice(1), a]),
  );
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        links.forEach((a, id) => a.toggleAttribute('aria-current', id === e.target.id));
      }
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  links.forEach((_, id) => { const el = document.getElementById(id); if (el) spy.observe(el); });
  spy.observe(document.getElementById('top')!);

  // Projects: on wide screens the section pins and the cards slide sideways as you scroll down.
  const works = document.getElementById('projects')!;
  const view = document.getElementById('cards-view')!;
  const cards = document.getElementById('cards')!;
  const count = document.getElementById('works-count')!;
  const cardEls = [...cards.children] as HTMLElement[];
  const wide = matchMedia('(min-width: 900px)');
  let dist = 0;
  const layoutWorks = () => {
    const pin = wide.matches && !reduced;
    works.classList.toggle('pinned', pin);
    cards.style.transform = '';
    dist = pin ? Math.max(0, cards.scrollWidth - view.clientWidth) : 0;
    works.style.height = pin ? `${innerHeight + dist}px` : '';
  };
  const onScroll = () => {
    if (works.classList.contains('pinned')) {
      const p = clamp(-works.getBoundingClientRect().top / (dist || 1));
      cards.style.transform = `translate3d(${(-p * dist).toFixed(1)}px,0,0)`;
      count.textContent = pad(Math.min(cardEls.length, 1 + Math.round(p * (cardEls.length - 1))));
    }
  };
  view.addEventListener('scroll', () => {
    const p = clamp(view.scrollLeft / Math.max(1, view.scrollWidth - view.clientWidth));
    count.textContent = pad(1 + Math.round(p * (cardEls.length - 1)));
  }, { passive: true });
  // Keyboard users: when focus lands on an off-screen card, scroll the page so it slides into view.
  cards.addEventListener('focusin', (e) => {
    if (!works.classList.contains('pinned')) return;
    const card = (e.target as HTMLElement).closest('.card') as HTMLElement | null;
    if (!card) return;
    const x = Math.min(dist, Math.max(0, card.offsetLeft - 20));
    scrollTo({ top: works.offsetTop + x, behavior: 'instant' as ScrollBehavior });
  });
  layoutWorks();
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', () => { layoutWorks(); onScroll(); });
  wide.addEventListener('change', () => { layoutWorks(); onScroll(); });

  // Cards tilt a little toward the pointer.
  if (!reduced) {
    cardEls.forEach((c) => {
      c.addEventListener('pointermove', (e) => {
        const r = c.getBoundingClientRect();
        c.style.setProperty('--rx', `${(((e.clientY - r.top) / r.height) - 0.5) * -6}deg`);
        c.style.setProperty('--ry', `${(((e.clientX - r.left) / r.width) - 0.5) * 8}deg`);
      });
      c.addEventListener('pointerleave', () => { c.style.removeProperty('--rx'); c.style.removeProperty('--ry'); });
    });
  }

  // Project details open in a native dialog: Esc closes it and focus returns to the button.
  // Smooth scrolling pauses while one is open.
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) => {
    const d = document.getElementById(b.dataset.open!) as HTMLDialogElement;
    b.addEventListener('click', () => { d.showModal(); document.dispatchEvent(new Event('lenis:stop')); });
    d.addEventListener('close', () => document.dispatchEvent(new Event('lenis:start')));
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
</script>

<style>
  .skip {
    position: absolute; left: 12px; top: -60px; z-index: 10;
    background: var(--text); color: var(--bg); padding: 10px 14px; border-radius: 6px; font-weight: 600;
  }
  .skip:focus { top: 12px; }

  /* Header: transparent over the hero, a quiet blurred bar after it. */
  .bar {
    position: sticky; top: 0; z-index: 5;
    margin-inline: -20px; padding-inline: 20px;
    border-bottom: 1px solid transparent;
    transition: background 0.5s var(--ease), border-color 0.5s var(--ease), backdrop-filter 0.5s var(--ease);
  }
  .bar.scrolled {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--line);
  }
  .bar-inner { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-block: 16px; }
  .mark { font: 700 1.3rem/1 var(--display); letter-spacing: -0.03em; color: var(--text); text-decoration: none; }
  .mark span { color: var(--accent); }
  nav { display: flex; align-items: center; gap: 26px; font: 450 0.9rem var(--sans); }
  nav a { color: var(--muted); text-decoration: none; transition: color 0.3s var(--ease); position: relative; }
  nav a:hover, nav a[aria-current] { color: var(--text); }
  nav a[data-nav]::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 1px; background: var(--accent);
    transform: scaleX(0); transform-origin: left; transition: transform 0.5s var(--ease);
  }
  nav a[aria-current]::after { transform: scaleX(1); }
  .nav-cta { padding: 8px 16px; border: 1px solid var(--line); border-radius: 999px; color: var(--text) !important; transition: border-color 0.3s; }
  .nav-cta:hover { border-color: var(--muted); }

  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Hero: words on the left, the rocket on the pad to the right. */
  .hero {
    min-height: calc(100vh - 70px); min-height: calc(100svh - 70px);
    display: flex; flex-direction: column; justify-content: center;
    padding-block: 40px 110px;
  }
  .hero-copy { max-width: 600px; display: grid; gap: 28px; }
  h1 { font-size: clamp(2.8rem, 6vw, 5.2rem); }
  .lede { font-size: 1.12rem; color: var(--muted); }
  :global(.no-gl) .hint { display: none; }
  .hint { position: absolute; right: 0; bottom: 40px; width: 42%; text-align: center; opacity: 0.8; }
  .scroll { position: absolute; left: 0; bottom: 36px; display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .scroll i { width: 1px; height: 36px; background: var(--line); position: relative; overflow: hidden; }
  .scroll i::after {
    content: ''; position: absolute; inset: 0; background: var(--accent);
    animation: drip 2.4s var(--ease) infinite;
  }
  @keyframes drip { from { transform: translateY(-100%); } to { transform: translateY(100%); } }

  /* At a glance: four quiet facts on one hairline. */
  .glance {
    margin: 0; padding-top: 28px; border-top: 1px solid var(--line);
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
  }
  .glance div { display: grid; gap: 10px; align-content: start; }
  .glance dd { margin: 0; font-size: 0.98rem; line-height: 1.5; }

  /* Sections */
  .block { padding-block: 160px 0; display: grid; gap: 48px; scroll-margin-top: 40px; }
  .head { display: grid; gap: 16px; }
  h2 { font-size: clamp(2.2rem, 4.4vw, 3.6rem); }
  .points { margin: 0; padding-left: 1.1em; display: grid; gap: 6px; color: var(--muted); }
  .points li::marker { color: var(--accent); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  .tags li { font: 450 0.76rem/1 var(--sans); padding: 7px 11px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }

  .period { font: 500 0.78rem var(--sans); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); font-variant-numeric: tabular-nums; }

  /* Experience: Mission Ravi-1. Each leg is one screen tall; the card sits left of the ship. */
  .flight { position: relative; z-index: 1; padding-top: 160px; }
  .flight-head { display: grid; gap: 16px; }
  .legs { list-style: none; margin: 0; padding: 0; }
  .leg { min-height: 100vh; min-height: 100svh; display: flex; align-items: center; }
  .leg > .wrap { width: 100%; }
  .leg-card {
    max-width: 440px; display: grid; gap: 14px; padding: 26px 28px; border-radius: 18px;
    background: color-mix(in srgb, var(--bg) 68%, transparent); border: 1px solid var(--line);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  }
  .leg-card .label b { color: var(--flame); }
  .leg-card h3 { font: 600 clamp(1.35rem, 2.3vw, 1.75rem)/1.2 var(--display); letter-spacing: -0.02em; }
  .leg-card .period { color: var(--flame); }
  .kept { display: grid; gap: 10px; padding-top: 14px; border-top: 1px solid var(--line); }
  .kept .tags li { border-color: color-mix(in srgb, var(--cool) 40%, var(--line)); color: var(--cool); }

  /* Projects: a full-width band; cards slide sideways. */
  .works { position: relative; margin: 180px -20px 0; padding-block: 90px; z-index: 1; }
  .works-head { width: 100%; max-width: 1120px; display: flex; justify-content: space-between; align-items: end; gap: 20px; padding-inline: 20px; margin-bottom: 44px; }
  .works-hint { white-space: nowrap; }
  .arrow { display: inline-block; margin-left: 6px; color: var(--accent); animation: nudge 2.4s var(--ease) infinite; }
  @keyframes nudge { 50% { transform: translateX(6px); } }

  .cards-view {
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    padding-inline: max(20px, calc((100vw - 1120px) / 2)); scroll-padding-inline: max(20px, calc((100vw - 1120px) / 2));
  }
  .cards-view::-webkit-scrollbar { display: none; }
  .cards { list-style: none; margin: 0; padding: 6px 0 12px; display: flex; gap: 20px; width: max-content; will-change: transform; perspective: 900px; }
  .card {
    scroll-snap-align: start; width: min(80vw, 340px); min-height: 340px;
    display: flex; flex-direction: column; gap: 14px; padding: 28px; border-radius: 20px;
    border: 1px solid var(--line); background: var(--surface);
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: border-color 0.5s var(--ease), transform 0.6s var(--ease);
  }
  .card:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .card h3 { font: 700 1.6rem/1.1 var(--display); letter-spacing: -0.03em; margin-top: auto; }
  .card p { color: var(--muted); font-size: 0.97rem; }
  .kind-lab { background: transparent; border-style: dashed; }
  .card-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .card-foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding-top: 16px; border-top: 1px solid var(--line); }
  .kind { font-size: 0.82rem; color: var(--muted); }
  .kind-lab .kind { color: var(--accent); }
  .more {
    font: 500 0.82rem var(--sans); padding: 7px 14px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--line); background: none; color: var(--text); transition: border-color 0.3s, background 0.3s;
  }
  .more:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); }

  .works.pinned { padding-block: 0; }
  .works.pinned .works-pin {
    position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden;
    display: flex; flex-direction: column; justify-content: center;
  }
  .works.pinned .cards-view { overflow: visible; scroll-snap-type: none; }

  /* Project detail popup */
  .detail {
    width: min(580px, calc(100vw - 32px)); padding: 0; border-radius: 20px; color: var(--text);
    border: 1px solid var(--line); background: var(--surface);
  }
  .detail::backdrop { background: color-mix(in srgb, var(--bg) 70%, transparent); backdrop-filter: blur(8px); }
  .detail[open] { animation: pop 0.5s var(--ease); }
